# 開発用 Firebase プロジェクトの設定（.env.development として配置する雛形）
# Firebase コンソール（開発用プロジェクト）> プロジェクトの設定 > 全般 > マイアプリ（Web）からコピーしてください。
# CI では GitHub Secrets の ENV_DEVELOPMENT からこのファイルが生成されます。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
