rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidUserDoc(data) {
      return data.keys().hasOnly(['displayName', 'state', 'updatedAt'])
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 40))
        && (!('state' in data) || data.state is map)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isNumberIn(value, minValue, maxValue) {
      return value is number && value >= minValue && value <= maxValue;
    }

    function isValidStats(stats) {
      return stats is map
        && stats.keys().hasOnly(['power', 'speed', 'stamina', 'technique', 'wisdom'])
        && isNumberIn(stats.power, 0, 500)
        && isNumberIn(stats.speed, 0, 500)
        && isNumberIn(stats.stamina, 0, 500)
        && isNumberIn(stats.technique, 0, 500)
        && isNumberIn(stats.wisdom, 0, 500);
    }

    function isValidPublicMonster(data) {
      return data.keys().hasOnly([
          'monsterId', 'ownerUid', 'ownerName', 'char', 'colorHex', 'fontId',
          'fontLabel', 'elementType', 'school', 'trait', 'specialMove', 'stats',
          'total', 'wins', 'losses', 'generation', 'isBred', 'publishedAt', 'updatedAt'
        ])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.ownerName is string
        && data.ownerName.size() <= 40
        && data.char is string
        && data.char.size() >= 1
        && data.char.size() <= 8
        && data.colorHex is string
        && data.colorHex.matches('^#[0-9a-fA-F]{6}$')
        && data.fontId is string
        && data.elementType is string
        && data.school is string
        && data.specialMove is string
        && data.specialMove.size() <= 80
        && isValidStats(data.stats)
        && isNumberIn(data.total, 0, 2500)
        && isNumberIn(data.wins, 0, 100000)
        && isNumberIn(data.losses, 0, 100000)
        && isNumberIn(data.generation, 1, 999)
        && data.isBred is bool;
    }

    // 自分のセーブデータ。本人だけが読み書きできます。
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && isValidUserDoc(request.resource.data);
      allow delete: if isSelf(uid);
    }

    // 単一セッションの札（同時に遊べる端末を1つにするため）。本人だけが読み書きできます。
    match /sessions/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['sessionId', 'updatedAt'])
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 64
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSelf(uid);
    }

    // みんなで使う対戦相手プール。読むことは誰でも可。
    // 登録・更新・削除は、モンスターの持ち主本人だけです。
    match /publicMonsters/{monsterDocId} {
      allow read: if true;
      allow create: if signedIn() && isValidPublicMonster(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && isValidPublicMonster(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
