{
  "dependencies": {
    "firebase": "^11.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "name": "moji-monster-firebase",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "build:dev": "tsc --noEmit -p tsconfig.json && vite build --mode development",
    "build:prod": "tsc --noEmit -p tsconfig.json && vite build --mode production",
    "deploy:dev": "npm run build:dev && firebase deploy --only hosting,firestore:rules -P dev",
    "deploy:prod": "npm run build:prod && firebase deploy --only hosting,firestore:rules -P prod"
  },
  "type": "module",
  "version": "1.0.0"
}
